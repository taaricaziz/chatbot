# AI API configuration for CafeBot.
# Copy this file to .env and fill in real values there.
# Never commit .env — it should stay out of version control.

AI_API_KEY=
AI_MODEL=

# Backend server port
PORT=3000

# Twilio auth token, used to verify incoming SMS webhook requests are really
# from Twilio. Optional — if unset, SMS requests are accepted unverified
# (fine for local testing, not recommended in production).
TWILIO_AUTH_TOKEN=
