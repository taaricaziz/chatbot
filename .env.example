# AI API configuration for CafeBot.
# Copy this file to .env and fill in real values there.
# Never commit .env — it should stay out of version control.

AI_API_KEY=
AI_MODEL=

# Backend server port
PORT=3000

# Twilio auth token, used to verify incoming SMS webhook requests are really
# from Twilio. Optional — if unset, SMS requests are accepted unverified
# (fine for local testing, not recommended in production).
TWILIO_AUTH_TOKEN=

# Vonage credentials for SMS ordering via the Vonage API (an alternative to
# Twilio — you only need one). VONAGE_API_KEY/SECRET are required to send
# replies; VONAGE_FROM_NUMBER is your Vonage virtual number. VONAGE_WEBHOOK_TOKEN
# is optional — a shared secret appended to the webhook URL as ?token=... to
# verify incoming requests (Vonage's classic SMS webhook isn't signed).
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=
VONAGE_WEBHOOK_TOKEN=
