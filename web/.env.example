# ---------------------------------------------------------------------------
# Gootee Cafe website (web/) — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres connection for the `gootee-cafe` Supabase project.
#
# THE DATABASE IS LIVE. Project okopmkyxractmwzejwrz is ACTIVE, all 15 tables
# exist, the invariants are enforced (see below), the menu, delivery zones and
# 12 tables are seeded, and orders have been verified to survive a restart.
#
# The site connects as `gootee_app`, a dedicated role with SELECT/INSERT/
# UPDATE/DELETE and BYPASSRLS — NOT the postgres superuser. It has no DDL
# rights: migrations are applied separately and deliberately.
#
#   postgresql://gootee_app.okopmkyxractmwzejwrz:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# THE HOST IS aws-0, NOT aws-1. This file said aws-1 for weeks and that is
# why the connection appeared impossible: aws-1 answers, accepts TLS, and
# then reports "tenant/user not found", which reads like an auth failure
# rather than a wrong address. Check which pooler your project is on in the
# dashboard rather than assuming — Supabase has several per region.
#
# pgbouncer=true disables prepared statements, which the transaction pooler
# (6543) cannot hold across connections. Port 5432 is session mode and also
# works, but holds a connection per client — wrong for serverless.
#
# To rotate this password:
#   ALTER ROLE gootee_app WITH PASSWORD 'new-one';   -- then update .env
#
# Enforced in the database, not just in code, so a bug or a hand-written
# UPDATE cannot violate them:
#   - no_double_booking          GiST exclusion; half-open ranges, so
#                                back-to-back sittings stay bookable
#   - one_open_session_per_table one live bill per table
#   - totals_reconcile           total = taxable + tax + delivery fee
#   - taxable = subtotal - discount, and line total = unit price x quantity
#   - dine_in_needs_session, delivery_needs_address
#
# Leave this blank and the site still runs: every repository falls back to
# the typed seed data and logs a warning. The database holds the SAME menu —
# the seed SQL was generated from src/lib/menu-seed.ts for that reason.
#
# NOTE: a free Supabase project pauses after a week of inactivity. If the
# site suddenly cannot connect, check whether the project needs restoring.
DATABASE_URL=

# Public site URL — canonical tags, OpenGraph, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase project API URL. Not used at runtime today (the app talks to
# Postgres through Prisma, not supabase-js) — recorded for reference.
# https://okopmkyxractmwzejwrz.supabase.co

# --- Staff console -------------------------------------------------------
# Signs the staff session cookie. At least 32 characters. Rotating it logs
# everyone out.
STAFF_SESSION_SECRET=

# Staff account. With no database, staff come from env vars.
#
# The hash is COLON-separated (scrypt:salt:hash), not the usual $-separated
# form — dotenv expands `$name` inside .env values even in quotes, which would
# silently truncate it to "scrypt".
#
# Generate one with:
#   node -e "const{randomBytes,scryptSync}=require('crypto');const s=randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
STAFF_EMAIL=
STAFF_PASSWORD_HASH=
STAFF_NAME=
STAFF_ROLE=OWNER

# --- Notifications -------------------------------------------------------
# Shared secret for POST /api/notifications/drain. Unset = endpoint disabled.
#
# HOBBY PLAN LIMIT: Vercel allows only ONE cron run per day on Hobby, so
# vercel.json drains at 03:00 rather than every five minutes. A queued
# confirmation would therefore wait up to a day.
#
# Two ways round it, neither requiring Pro:
#   - point a free external scheduler (cron-job.org, GitHub Actions) at
#     POST https://<site>/api/notifications/drain with this secret, every
#     few minutes; or
#   - leave it, which is fine while no delivery provider is configured —
#     messages are written to the server log rather than sent.
NOTIFY_CRON_SECRET=

# Email delivery. Unset = messages are logged to the console instead of sent,
# which is the default and is genuinely useful in development.
RESEND_API_KEY=
RESEND_FROM=

# --- The assistant ------------------------------------------------------
# Pick ONE. The first key found wins, and FREE PROVIDERS ARE TRIED FIRST,
# so adding a free key is all it takes to stop paying.
#
#   Groq      https://console.groq.com/keys        no card, fastest
#   Gemini    https://aistudio.google.com/apikey   no card
#   Cerebras  https://cloud.cerebras.ai            no card
#
# MEASURED on a real Groq free key (September 2026), because published
# figures disagree with each other:
#
#   1,000 requests per day   — generous; the app's own cap of 200 sits under it
#   8,000 tokens per MINUTE  — the limit that actually binds
#
# One full conversation costs roughly 3,800 tokens, so the free tier allows
# about two per minute. Check your own limits with:
#   curl -sD - -o /dev/null https://api.groq.com/openai/v1/chat/completions #     -H "Authorization: Bearer $GROQ_API_KEY" -H 'Content-Type: application/json' #     -d '{"model":"openai/gpt-oss-120b","max_tokens":5,"messages":[{"role":"user","content":"hi"}]}' #     | grep -i x-ratelimit
#
# When that window is hit the assistant says it is busy and to try in a
# minute — not that it is broken, and not silently.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Optional. Unset means "auto-detect from whichever key is present, free
# first". Set it to pin one: groq | gemini | cerebras | openrouter | ollama |
# anthropic.
AGENT_PROVIDER=

# Optional, and PROVIDER-SCOPED — GROQ_MODEL, GEMINI_MODEL, CEREBRAS_MODEL.
# Prefer these to the generic AGENT_MODEL below, which applies to whichever
# provider wins and is therefore easy to point at the wrong one.
#
# Model catalogues rot: Groq retired every Llama chat model between releases,
# so a name that worked last month can 404. If that happens the error lists
# what the provider actually has.
GROQ_MODEL=openai/gpt-oss-120b

# Generic fallback. A name that clearly belongs to another provider
# (claude-*, gemini-*) is ignored rather than sent somewhere it cannot work.
AGENT_MODEL=

# Optional. Points the OpenAI-compatible adapter somewhere else entirely — a
# local Ollama (AGENT_PROVIDER=ollama needs no key at all), a proxy, or a test
# double. Ollama is genuinely free and needs no account, but cannot be
# deployed to Vercel; it is the local-development answer.
AGENT_BASE_URL=

# The meter. Defaults sit below every free tier: 200 model calls per Karachi
# day, 40 per conversation. The day resets at Karachi midnight, not UTC, so a
# Friday dinner rush is not split across two budget days.
AGENT_DAILY_CALLS=
AGENT_CONVERSATION_CALLS=

# Only meaningful on a PAID provider. Unset or 0 means no spend ceiling,
# which is correct on a free tier — a money limit nobody funded must never be
# the thing that denies service.
AGENT_MONTHLY_USD=

# Soft-launch switch. Set to "false" to take the assistant off the site
# without removing its key. Anything else, plus a working provider, means on.
#
# For an immediate stop, use the button in the staff console instead: an env
# change needs a redeploy, and a kill switch that needs a redeploy is not one.
AGENT_ENABLED=

# What fraction of visitors are OFFERED the assistant, 0-100. Default 100.
# The same visitor always gets the same answer, so it does not flicker as
# they browse. This limits who MEETS it, not who is served — somebody
# mid-conversation is never cut off by lowering it.
AGENT_ROLLOUT_PERCENT=

# --- WhatsApp (Phase 14.5) ------------------------------------------------
# The webhook is built and tested; what it waits on is Meta business
# verification and template approval, which is weeks of an external queue.
#
# With WHATSAPP_TOKEN unset, replies are written to the server log exactly as
# they would have been sent — the whole inbound-to-reply path is exercisable
# without a Meta account.
#
# WHATSAPP_APP_SECRET is NOT optional in effect: the webhook refuses every
# request when it is unset, because an unauthenticated endpoint that can
# place orders is not a soft failure.
#
#   Webhook URL:  https://<site>/api/webhooks/whatsapp
#   Verify token: whatever you put in WHATSAPP_VERIFY_TOKEN
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
